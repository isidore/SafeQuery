<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SafeQuery</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>safequery</ToolCommandName>
    <PackageId>SafeQuery</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Llewellyn Falco</Authors>
    <Description>Read-only SQL Server query CLI that rejects anything but SELECT, plus a schema-to-Mermaid diagram generator.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>sql;sqlserver;readonly;cli;dotnet-tool;mermaid</PackageTags>
    <!-- Naiad's SponsorCheck: we are a non-revenue open source project. Renew yearly (max 12 months out). -->
    <Papyrine_SponsorshipExemption>OpenSource</Papyrine_SponsorshipExemption>
    <Papyrine_SponsorshipExemptionUntil>2027-10</Papyrine_SponsorshipExemptionUntil>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Naiad.Skia" />
    <PackageReference Include="SqlServerToMermaid" />
    <PackageReference Include="Naiad" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SafeQuery.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SafeQuery</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>safequery</ToolCommandName>
    <PackageId>SafeQuery</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Llewellyn Falco</Authors>
    <Description>Read-only SQL Server query CLI that rejects anything but SELECT, plus a schema-to-Mermaid diagram generator.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>sql;sqlserver;readonly;cli;dotnet-tool;mermaid</PackageTags>
    <!-- Naiad's SponsorCheck demands a sponsorship license; we explicitly decline (downgrades SC021 error to SC023 warning). -->
    <Papyrine_SponsorshipLicenseIgnored>true</Papyrine_SponsorshipLicenseIgnored>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-rc.2.26504.105" />
    <PackageReference Include="Naiad.Skia" Version="2.0.1" />
    <PackageReference Include="SqlServerToMermaid" Version="2.4.0" />
    <PackageReference Include="Naiad" Version="2.0.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SafeQuery.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
